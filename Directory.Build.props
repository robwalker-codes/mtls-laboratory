<Project><PropertyGroup>
<TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
<TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
<NuGetLockFilePath Condition="'$(BouncyCastleSource)' != ''">$(MSBuildProjectDirectory)/obj/source-debug.packages.lock.json</NuGetLockFilePath>
</PropertyGroup></Project>
